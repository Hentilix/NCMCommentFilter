{
  "manifest_version": 1,
  "name": "BetterNEM 评论过滤",
  "slug": "betternem-comment-filter",
  "version": "0.2.1",
  "betterncm_version": ">=1.3.1",
  "ncm-version-req": "=3.1.41",
  "ncm3-compatible": true,
  "author": "BetterNEM",
  "description": "按当前账号的用户黑名单过滤专辑和单曲评论，不留空白占位",
  "type": "extension",
  "require_restart": false,
  "injects": {
    "Main": [
      { "file": "main.js" }
    ]
  }
}
